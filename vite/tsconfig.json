{
	"compilerOptions": {
		"esModuleInterop": true,
		"isolatedModules": true,
		"lib": ["DOM", "ESNext"],
		"moduleResolution": "bundler",
		"module": "esnext",
		"noEmit": true,
		"useDefineForClassFields": true,
		"target": "esnext",
		"skipLibCheck": false,
		"sourceMap": true,
		"resolveJsonModule": true,
		"strict": true
	},
	"include": ["src"]
}
